{
    "interface_version": 2,
    "name": "MaaHunDang",
    "contact": "QQ群: 1058992601",
    "license": "LICENSE",
    "welcome": [
        "resource/announcement/1.简介.md",
        "resource/announcement/2.使用说明.md",
        "resource/announcement/3.百战须知.md",
        "resource/announcement/4.用户协议.md",
        "resource/announcement/5.加入我们.md"
    ],
    "github": "https://github.com/liao-2004/MAA-hunDang",
    "description": "本软件开源免费,受AGPL v3协议保护。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "==启动游戏==",
            "entry": "==启动游戏==",
            "group": [
                "百战方案"
            ],
            "option": []
        },
        {
            "name": "==每日奖励==",
            "entry": "==每日奖励==",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "option": [
                "更改任务",
                "领取任务",
                "VIP每日异界赠礼"
            ],
            "default_check": true,
            "group": [
                "每日大厅"
            ]
        },
        {
            "name": "==开始游戏==",
            "entry": "===开始===",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "option": [
                "永久VIP",
                "是否有火斧",
                "每日挑战",
                "狭缝角色祝福"
            ],
            "group": [
                "百战方案"
            ]
        },
        {
            "name": "==密闻抽卡==",
            "entry": "==密闻抽卡==",
            "group": [
                "每日大厅"
            ]
        },
        {
            "name": "==退出游戏==",
            "entry": "==退出游戏==",
            "group": [
                "百战方案"
            ],
            "option": []
        },
        {
            "name": "==检测边境==",
            "entry": "==检测边境==",
            "group": [
                "其他工具"
            ],
            "description": "运行后没有行动、更改过UI大小、启动选项任务后将屏幕包裹滑动范围(手机端)"
        }
    ],
    "label": "Maa_深境_扫荡",
    "option": {
        "永久VIP": {
            "cases": [
                {
                    "name": "Yes",
                    "option": []
                },
                {
                    "name": "No",
                    "option": [],
                    "pipeline_override": {
                        "复活": {
                            "recognition": {
                                "type": "TemplateMatch",
                                "param": {
                                    "roi": [
                                        434,
                                        581,
                                        117,
                                        46
                                    ],
                                    "template": [
                                        "战斗场景/放弃挣扎.png"
                                    ]
                                }
                            }
                        }
                    }
                }
            ],
            "label": "永久VIP",
            "default_case": "No",
            "type": "switch",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "description": "用于是否复活判断"
        },
        "是否有火斧": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "option": []
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "锻造场景": {
                            "next": "离开地点_动作"
                        }
                    }
                }
            ],
            "label": "火斧",
            "default_case": "No",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "description": "用于锻造升变策略"
        },
        "每日挑战": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "option": [],
                    "pipeline_override": {
                        "结束探索": {
                            "next": [
                                "前往观星室",
                                "点击空白关闭",
                                "结束探索",
                                "开始游戏_点空白处关闭"
                            ]
                        },
                        "点击空白关闭": {
                            "next": [
                                "结束探索",
                                "点击空白关闭",
                                "前往观星室",
                                "开始游戏_点空白处关闭"
                            ]
                        },
                        "===开始===": {
                            "next": [
                                "前往观星室",
                                "每日挑战-开始",
                                "每日挑战",
                                "统合"
                            ]
                        },
                        "滑动难度": {
                            "on_error": [
                                "每日挑战-开始"
                            ]
                        },
                        "开始游戏_关闭窗口": {
                            "next": [
                                "开始游戏_关闭窗口",
                                "前往观星室"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "label": "每日挑战",
            "default_case": "No"
        },
        "更改任务": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "前往大厅": {
                            "next": [
                                "更改任务",
                                "前往大厅1"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No",
            "description": "更改任务(尚未完善、确保密闻足够多次刷新再勾选)"
        },
        "VIP每日异界赠礼": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "前往大厅2": {
                            "next": [
                                "商店异界赠礼(仅VIP可用)"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "label": "VIP每日异界赠礼",
            "default_case": "No"
        },
        "领取任务": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "前往大厅1": {
                            "next": [
                                "前往领取任务",
                                "前往大厅2"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "狭缝角色祝福": {
            "type": "checkbox",
            "cases": [
                {
                    "name": "万法",
                    "pipeline_override": {
                        "狭缝": {
                            "next": [
                                "战斗场景",
                                "选择卡片-复制",
                                "选择卡片",
                                "狭缝",
                                "直接离开"
                            ]
                        }
                    }
                },
                {
                    "name": "复仇者",
                    "pipeline_override": {
                        "战斗_首次攻击": {
                            "next": [
                                "自动战斗",
                                "夺魄_祝福"
                            ]
                        }
                    }
                }
            ],
            "label": "狭缝角色祝福",
            "resource": [],
            "default_case": [],
            "min_count": 0,
            "max_count": 2,
            "description": "勾选拥有的角色、便于局内识别"
        }
    },
    "group": [
        {
            "name": "每日大厅"
        },
        {
            "name": "百战方案",
            "default_expand": true,
            "label": "百战方案"
        },
        {
            "name": "其他工具",
            "description": "该功能非必须开启，以免照成不必要的内存损耗"
        }
    ],
    "global_option": [],
    "label": "Maa_魂境_扫荡",
    // "icon": "resource\\announcement\\images\\hz_logo.ico"
}