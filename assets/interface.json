{
    "interface_version": 2,
    "name": "MaaHunDang",
    "icon": "resource/logo.ico",
    "contact": "QQ群: 1058992601",
    "license": "LICENSE",
    "welcome": [
        "resource/announcement/1.简介.md",
        "resource/announcement/2.使用说明.md",
        "resource/announcement/3.百战须知.md",
        "resource/announcement/4.用户协议.md",
        "resource/announcement/5.加入我们.md"
    ],
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/liao-2004/MAA-hunDang",
    "description": "本软件开源免费,受AGPL v3协议保护。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "==启动游戏==",
            "entry": "==启动游戏==",
            "group": [
                "百战方案"
            ],
            "option": [],
            "default_check": true
        },
        {
            "name": "==开始游戏==",
            "entry": "===开始===",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "option": [],
            "group": [
                "百战方案"
            ],
            "default_check": true
        },
        {
            "name": "==每日挑战==",
            "entry": "===开始===",
            "pipeline_override": {
                "结束探索": {
                    "next": [
                        "前往观星室",
                        "点击空白关闭",
                        "结束探索"
                    ]
                },
                "点击空白关闭": {
                    "next": [
                        "结束探索",
                        "点击空白关闭",
                        "前往观星室"
                    ]
                },
                "进入游戏": {
                    "next": [
                        "前往观星室",
                        "进入游戏",
                        "战斗场景",
                        "地图场景",
                        "事件逻辑"
                    ]
                },
                "===开始===": {
                    "next": [
                        "前往观星室",
                        "每日挑战-开始",
                        "每日挑战",
                        "战斗场景",
                        "地图场景",
                        "事件逻辑"
                    ]
                },
                "事件逻辑": {
                    "on_error": [
                        "选择卡片",
                        "未知事件",
                        "前往观星室",
                        "统合"
                    ]
                },
                "滑动难度": {
                    "on_error": [
                        "每日挑战-开始"
                    ]
                },
                "开始游戏_关闭窗口": {
                    "next": [
                        "开始游戏_关闭窗口",
                        "前往观星室"
                    ]
                }
            },
            "option": [],
            "resource": [
                "官服"
            ],
            "controller": [
                "安卓端"
            ],
            "group": [
                "百战方案"
            ],
            "default_check": false
        },
        {
            "name": "==密闻抽卡==",
            "entry": "==密闻抽卡==",
            "group": [
                "其他工具"
            ]
        },
        {
            "name": "==退出游戏==",
            "entry": "==退出游戏==",
            "group": [
                "百战方案"
            ],
            "option": [],
            "default_check": true
        },
        {
            "name": "==检测边境==",
            "entry": "==检测边境==",
            "group": [
                "其他工具"
            ],
            "description": "初次进游戏若无自动操作，得适配ui,，进入设置，更改ui大小，游戏框需在滑动区域内(非必要不要选入任务，以免造成不必要的性能损耗)"
        }
    ],
    "option": {
        "永久VIP": {
            "cases": [
                {
                    "name": "Yes",
                    "option": []
                },
                {
                    "name": "No",
                    "option": [],
                    "pipeline_override": {
                        "复活": {
                            "recognition": {
                                "type": "TemplateMatch",
                                "param": {
                                    "roi": [
                                        442,
                                        586,
                                        98,
                                        35
                                    ],
                                    "template": [
                                        "战斗场景/放弃挣扎.png"
                                    ]
                                }
                            },
                            "timeout": -1,
                            "next": [
                                "终结"
                            ]
                        },
                        "复活1": {
                            "recognition": {
                                "type": "TemplateMatch",
                                "param": {
                                    "roi": [
                                        442,
                                        586,
                                        98,
                                        35
                                    ],
                                    "template": [
                                        "战斗场景/放弃挣扎.png"
                                    ]
                                }
                            },
                            "timeout": -1,
                            "next": [
                                "终结"
                            ]
                        }
                    }
                }
            ],
            "label": "永久VIP",
            "default_case": "No",
            "type": "switch",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "description": "用于是否复活判断"
        },
        "是否有火斧": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "option": []
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "锻造场景": {
                            "next": "离开地点_动作"
                        }
                    }
                }
            ],
            "label": "火斧",
            "default_case": "No",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "官服"
            ],
            "description": "用于锻造升变策略"
        }
    },
    "group": [
        {
            "name": "百战方案",
            "default_expand": true
        },
        {
            "name": "其他工具"
        }
    ],
    "global_option": [
        "是否有火斧",
        "永久VIP"
    ],
    "label": "Maa_魂境_扫荡"
}